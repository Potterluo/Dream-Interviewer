# Dream Interviewer — copy to .env and fill in. .env is gitignored; this file is not.
#
# Precedence (highest first): values set by an admin in the UI (stored in the DB)
#   > real environment variables > this file > built-in defaults.
# A variable already present in the real environment is NEVER overwritten by
# this file, so containers can override a baked-in .env.

# --- Server -----------------------------------------------------------------
# APP_PORT=8080
# APP_BIND=loopback            # loopback | all
# APP_DATA_DIR=./data
# APP_LOG_LEVEL=info           # debug | info | warn | error

# --- Storage ----------------------------------------------------------------
# APP_DB_TYPE=sqlite           # sqlite | postgres
# APP_DB_DSN=                  # postgres DSN, or an explicit sqlite path
# APP_DB_AUTO_MIGRATE=true

# --- Security ---------------------------------------------------------------
# APP_COOKIE_SECURE=false      # set true behind HTTPS
# APP_RATE_LIMIT_RPM=0         # per-user requests/min on /api/*; 0 = unlimited

# --- Interviewer model ------------------------------------------------------
# Nothing is configured by default and NO key is compiled into the binary.
# Without these the app still works: it falls back to the bundled question bank
# and the deterministic rubric, and says so in the UI.
#
# You can also configure the model at runtime as an admin at /admin/model/, which
# takes precedence over this file.
#
# APP_LLM_PROVIDER=siliconflow  # custom | siliconflow | openai
# APP_LLM_BASE_URL=https://api.siliconflow.cn/v1
# APP_LLM_API_KEY=
# APP_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# APP_LLM_TIMEOUT_SEC=90
# APP_LLM_MAX_TOKENS=8192       # reasoning models bill their thinking against this
# APP_LLM_TEMPERATURE=0.4

# --- Dev --------------------------------------------------------------------
# APP_DEV_PROXY=http://localhost:3000
