type FormValues = Record<string, string | boolean>;

export default function [[.TitlePlural]]Page() {
  const { user } = useUser();
  const [rows, setRows] = useState<[[.TitleCamel]][] | null>(null);
  const [editor, setEditor] = useState<{ open: boolean; row: [[.TitleCamel]] | null }>({ open: false, row: null });
  const [removing, setRemoving] = useState<[[.TitleCamel]] | null>(null);
  const [error, setError] = useState("");

  const reload = useCallback(async () => {
    const res = await list[[.TitlePlural]](isAdmin(user));
    if (res.ok) setRows(res.[[.Plural]] ?? []);
    else setError(res.error || "failed to load [[.Plural]]");
  }, [user]);

  useEffect(() => {
    reload();
  }, [reload]);

  // Live updates from any tab/client via the SSE hub.
  useEffect(() => {
    return subscribeEvents((evt) => {
      if (evt.type.startsWith("[[.Singular]].")) reload();
    });
  }, [reload]);

  return (
    <div className="grid gap-6">
      <div className="flex items-start justify-between">
        <div>
          <h1 className="font-heading text-2xl font-semibold">[[.TitlePlural]]</h1>
          <p className="text-sm text-muted-foreground">
            {isAdmin(user) ? "Admin view: all users' rows." : "Your own rows."}
          </p>
        </div>
        <Button onClick={() => setEditor({ open: true, row: null })}>
          <Plus className="h-4 w-4" /> New [[.Singular]]
        </Button>
      </div>

      {error && <p className="text-sm text-destructive">{error}</p>}

      <Card>
        <CardHeader>
          <CardTitle>All [[.TitlePlural]]</CardTitle>
          <CardDescription>{rows?.length ?? "…"} entries</CardDescription>
        </CardHeader>
        <CardContent>
          {rows === null ? (
            <div className="grid gap-2">
              <Skeleton className="h-9 w-full" />
              <Skeleton className="h-9 w-full" />
            </div>
          ) : rows.length === 0 ? (
            <p className="py-10 text-center text-sm text-muted-foreground">
              Nothing here yet — create the first one.
            </p>
          ) : (
            <Table>
              <TableHeader>
                <TableRow>
[[range .Fields]][[if eq .Type "bool"]]                  <TableHead className="w-12">[[.Title]]</TableHead>
[[else if eq .Type "text"]]                  <TableHead className="hidden md:table-cell">[[.Title]]</TableHead>
[[else]]                  <TableHead>[[.Title]]</TableHead>
[[end]][[end]]                  <TableHead className="w-24 text-right">Actions</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {rows.map((row) => (
                  <TableRow key={row.id}>
[[range .Fields]][[if eq .Type "bool"]]                    <TableCell>
                      <Toggle checked={row.[[.JSONName]]} onChange={() => toggle(row, "[[.JSONName]]")} />
                    </TableCell>
[[else if eq .Type "text"]]                    <TableCell className="hidden max-w-64 truncate text-muted-foreground md:table-cell">
                      {display(row, "[[.JSONName]]")}
                    </TableCell>
[[else]]                    <TableCell className="font-medium">
                      {display(row, "[[.JSONName]]")}
                    </TableCell>
[[end]][[end]]                    <TableCell className="text-right">
                      <div className="flex justify-end gap-1">
                        <Button variant="ghost" size="icon" aria-label="Edit" onClick={() => setEditor({ open: true, row })}>
                          <Pencil className="h-4 w-4" />
                        </Button>
                        <Button variant="ghost" size="icon" aria-label="Delete" onClick={() => setRemoving(row)}>
                          <Trash2 className="h-4 w-4 text-destructive" />
                        </Button>
                      </div>
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          )}
        </CardContent>
      </Card>

      <[[.TitleCamel]]Editor
        open={editor.open}
        row={editor.row}
        onOpenChange={(open) => setEditor({ open, row: open ? editor.row : null })}
        onSaved={() => {
          setEditor({ open: false, row: null });
          reload();
        }}
      />

      <Dialog open={!!removing} onOpenChange={(open) => !open && setRemoving(null)}>
        <DialogContent className="sm:max-w-sm">
          <DialogHeader>
            <DialogTitle>Delete [[.Singular]]?</DialogTitle>
            <DialogDescription>This cannot be undone.</DialogDescription>
          </DialogHeader>
          <DialogFooter>
            <Button variant="outline" onClick={() => setRemoving(null)}>
              Cancel
            </Button>
            <Button
              variant="destructive"
              onClick={async () => {
                if (removing) await delete[[.TitleCamel]](removing.id);
                setRemoving(null);
                reload();
              }}
            >
              Delete
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );

  async function toggle(row: [[.TitleCamel]], key: string) {
    await update[[.TitleCamel]](row.id, { [key]: !(row as unknown as Record<string, unknown>)[key] });
    reload();
  }
}

// display formats one cell: booleans as yes/no, everything else as text.
function display(row: [[.TitleCamel]], key: string): string {
  const v = (row as unknown as Record<string, unknown>)[key];
  if (typeof v === "boolean") return v ? "yes" : "no";
  return String(v ?? "");
}

function Toggle({ checked, onChange }: { checked: boolean; onChange: () => void }) {
  return (
    <button
      aria-label={checked ? "Turn off" : "Turn on"}
      className="flex h-5 w-5 items-center justify-center rounded border transition-colors hover:bg-accent data-[checked=true]:border-primary data-[checked=true]:bg-primary data-[checked=true]:text-primary-foreground"
      data-checked={checked}
      onClick={onChange}
    >
      {checked && (
        <svg viewBox="0 0 24 24" className="h-3.5 w-3.5" fill="none" stroke="currentColor" strokeWidth="3">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      )}
    </button>
  );
}

function [[.TitleCamel]]Editor({
  open,
  row,
  onOpenChange,
  onSaved,
}: {
  open: boolean;
  row: [[.TitleCamel]] | null;
  onOpenChange: (open: boolean) => void;
  onSaved: () => void;
}) {
  const editing = !!row;
  const [form, setForm] = useState<FormValues>({});
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);

  useEffect(() => {
    if (!open) return;
    setError("");
    const src = (row ?? {}) as unknown as Record<string, unknown>;
    setForm({
[[range .Fields]]      [[.JSONName]]: [[if eq .Type "bool"]]Boolean(src["[[.JSONName]]"] ?? false)[[else if eq .Type "int"]]String(src["[[.JSONName]]"] ?? "0")[[else]]String(src["[[.JSONName]]"] ?? "")[[end]],
[[end]]    });
  }, [open, row]);

  function setField(key: string, value: string | boolean) {
    setForm((f) => ({ ...f, [key]: value }));
  }

  async function save() {
    setBusy(true);
    setError("");
    try {
      const payload = {
[[range .Fields]]        [[.JSONName]]: [[if eq .Type "bool"]]Boolean(form["[[.JSONName]]"])[[else if eq .Type "int"]]Number(form["[[.JSONName]]"] || 0)[[else]]String(form["[[.JSONName]]"] ?? "")[[end]],
[[end]]      };
      const res = editing
        ? await update[[.TitleCamel]](row!.id, payload)
        : await create[[.TitleCamel]](payload);
      if (res.ok) {
        onSaved();
      } else {
        setError(res.error || "failed to save");
      }
    } finally {
      setBusy(false);
    }
  }

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-md">
        <DialogHeader>
          <DialogTitle>{editing ? "Edit [[.Singular]]" : "New [[.Singular]]"}</DialogTitle>
          <DialogDescription>
            {editing ? "Update the fields and save." : "Fill in the fields and save."}
          </DialogDescription>
        </DialogHeader>
        <div className="grid gap-4">
[[range .Fields]][[if eq .Type "text"]]          <div className="grid gap-2">
            <Label htmlFor="[[$.Singular]]-[[.JSONName]]">[[.Title]]</Label>
            <Textarea
              id="[[$.Singular]]-[[.JSONName]]"
              rows={3}
              value={String(form["[[.JSONName]]"] ?? "")}
              onChange={(e) => setField("[[.JSONName]]", e.target.value)}
            />
          </div>
[[else if eq .Type "bool"]]          <label className="flex cursor-pointer items-center gap-2 text-sm">
            <Toggle checked={Boolean(form["[[.JSONName]]"])} onChange={() => setField("[[.JSONName]]", !Boolean(form["[[.JSONName]]"]))} />
            [[.Title]]
          </label>
[[else]]          <div className="grid gap-2">
            <Label htmlFor="[[$.Singular]]-[[.JSONName]]">[[.Title]]</Label>
            <Input
              id="[[$.Singular]]-[[.JSONName]]"
              type={[[if eq .Type "int"]]"number"[[else]]"text"[[end]]}
              value={String(form["[[.JSONName]]"] ?? "")}
              onChange={(e) => setField("[[.JSONName]]", e.target.value)}
            />
          </div>
[[end]][[end]]          {error && <p className="text-sm text-destructive">{error}</p>}
        </div>
        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)}>
            Cancel
          </Button>
          <Button onClick={save} disabled={busy}>
            {busy ? "Saving…" : "Save"}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
