func (s *Server) handleList[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	ident, _ := auth.FromContext(r.Context())
	userID := ident.UserID
	if ident.IsAdmin() && r.URL.Query().Get("all") == "true" {
		userID = ""
	}
	rows, err := s.store.List[[.TitleCamel]](r.Context(), userID)
	if err != nil {
		storeError(w, err)
		return
	}
	out := make([][[.TitleCamelLower]]DTO, 0, len(rows))
	for i := range rows {
		out = append(out, to[[.TitleCamel]]DTO(&rows[i]))
	}
	writeOK(w, map[string]any{"[[.Plural]]": out})
}

func (s *Server) handleCreate[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	ident, _ := auth.FromContext(r.Context())
	var req struct {
[[range $f := .Fields]]		[[$f.GoName]] [[.GoType]] `json:"[[$f.JSONName]]"`
[[end]]	}
	if !readJSON(w, r, &req) {
		return
	}
	row := &store.[[.TitleCamel]]{
		UserID: ident.EffectiveUserID(),
[[range $f := .Fields]]		[[$f.GoName]]: req.[[$f.GoName]],
[[end]]	}
	id, err := randomID("[[.Singular]]_")
	if err != nil {
		storeError(w, err)
		return
	}
	row.ID = id
	if err := s.store.Create[[.TitleCamel]](r.Context(), row); err != nil {
		storeError(w, err)
		return
	}
	s.hub.PublishTo(row.UserID, events.Event{Type: "[[.Singular]].created", Data: to[[.TitleCamel]]DTO(row)})
	writeJSON(w, http.StatusCreated, map[string]any{"ok": true, "[[.Singular]]": to[[.TitleCamel]]DTO(row)})
}

// loadOwned[[.TitleCamel]] enforces ownership with the 404-for-strangers rule.
func (s *Server) loadOwned[[.TitleCamel]](w http.ResponseWriter, r *http.Request) (*store.[[.TitleCamel]], bool) {
	ident, _ := auth.FromContext(r.Context())
	row, err := s.store.Get[[.TitleCamel]](r.Context(), r.PathValue("id"))
	if err != nil {
		storeError(w, err)
		return nil, false
	}
	if row.UserID != ident.UserID && !ident.IsAdmin() {
		writeError(w, http.StatusNotFound, "not found")
		return nil, false
	}
	return row, true
}

func (s *Server) handleGet[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	row, ok := s.loadOwned[[.TitleCamel]](w, r)
	if !ok {
		return
	}
	writeOK(w, map[string]any{"[[.Singular]]": to[[.TitleCamel]]DTO(row)})
}

func (s *Server) handleUpdate[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	row, ok := s.loadOwned[[.TitleCamel]](w, r)
	if !ok {
		return
	}
	var req struct {
[[range $f := .Fields]]		[[$f.GoName]] *[[.GoType]] `json:"[[$f.JSONName]]"`
[[end]]	}
	if !readJSON(w, r, &req) {
		return
	}
[[range $f := .Fields]]	if req.[[$f.GoName]] != nil {
		row.[[$f.GoName]] = *req.[[$f.GoName]]
	}
[[end]]	if err := s.store.Update[[.TitleCamel]](r.Context(), row); err != nil {
		storeError(w, err)
		return
	}
	s.hub.PublishTo(row.UserID, events.Event{Type: "[[.Singular]].updated", Data: to[[.TitleCamel]]DTO(row)})
	writeOK(w, map[string]any{"[[.Singular]]": to[[.TitleCamel]]DTO(row)})
}

func (s *Server) handleDelete[[.TitleCamel]](w http.ResponseWriter, r *http.Request) {
	row, ok := s.loadOwned[[.TitleCamel]](w, r)
	if !ok {
		return
	}
	if err := s.store.Delete[[.TitleCamel]](r.Context(), row.ID); err != nil {
		storeError(w, err)
		return
	}
	s.hub.PublishTo(row.UserID, events.Event{Type: "[[.Singular]].deleted", Data: to[[.TitleCamel]]DTO(row)})
	writeOK(w, nil)
}
